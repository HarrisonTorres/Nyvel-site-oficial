@page "/not-found"
@layout MainLayout

<PageTitle>Página não encontrada · NYVEL</PageTitle>

<section class="hero" style="padding: 140px 0;">
    <div class="container hero-inner">
        <span class="eyebrow">Erro 404</span>
        <h1 class="hero-title">Essa página saiu do <span class="gradient-text">nível</span>.</h1>
        <p class="hero-sub">O conteúdo que você procura não existe ou foi movido.</p>
        <div class="hero-actions">
            <a class="btn btn-primary" href="/">Voltar ao início</a>
        </div>
    </div>
    <div class="hero-glow" aria-hidden="true"></div>
</section>
